# FlowHunt API key — required by the `translate` step in build_content.sh
# Generate one at https://app.flowhunt.io and paste below.
FLOWHUNT_API_KEY=

# Translation automatically detects the workspace linked to the API key via
# /v2/auth/me. Override only when needed; the key must have access to it.
# FLOWHUNT_WORKSPACE_ID=your-workspace-id
# Override the shared translation flow if using a different flow in your workspace.
# FLOWHUNT_FLOW_ID=9df82032-0c90-4a60-8538-5d724590562b

# Hugging Face access token — required to download the embedding model
# google/embeddinggemma-300m, which is a GATED repo. Without it the
# embedding steps (generate_related_content, generate_paragraph_linkbuilding)
# fail with a 401 GatedRepoError. Create a token at https://huggingface.co/settings/tokens
# and accept the model license at https://huggingface.co/google/embeddinggemma-300m
HF_TOKEN=

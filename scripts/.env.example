# FlowHunt API key — required by the `translate` step in build_content.sh
# Generate one at https://app.flowhunt.io and paste below.
FLOWHUNT_API_KEY=

# The key must have access to the workspace that owns the translation flow.
# Without overrides, translation uses the shared defaults below. Set BOTH IDs
# when using a translation flow in another workspace. A valid key can still
# return 401 when the workspace does not match.
# FLOWHUNT_WORKSPACE_ID=70ff1135-5ce6-42a7-8abe-ec03f58e828e
# FLOWHUNT_FLOW_ID=9df82032-0c90-4a60-8538-5d724590562b

# Hugging Face access token — required to download the embedding model
# google/embeddinggemma-300m, which is a GATED repo. Without it the
# embedding steps (generate_related_content, generate_clustering,
# generate_site_audit, generate_paragraph_linkbuilding) fail with a 401
# GatedRepoError. Create a token at https://huggingface.co/settings/tokens
# and accept the model license at https://huggingface.co/google/embeddinggemma-300m
HF_TOKEN=

# Optional: cap on parallel embedding workers for ML-heavy steps
# (generate_clustering, generate_site_audit). Each worker loads a ~1–2 GB
# sentence-transformer model — fanning out across all 20+ language dirs at
# once OOMs machines with <32 GB RAM and burns SSD lifespan via swap.
#
# Default: 3
# Set to 1 or 2 on smaller machines, raise to 5+ if you have plenty of RAM.
# MAX_PARALLEL_EMBED=3
